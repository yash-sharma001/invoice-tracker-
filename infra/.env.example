# Copy to infra/.env and adjust. docker-compose loads this into every service.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=invoice_tracker

# --- Database URL (host is the compose service name) ---
PG_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/invoice_tracker
HASURA_GRAPHQL_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/invoice_tracker
# ocr-service's own database (Hasura source "ocr") — review_queue only, so it
# stays independent of the core `invoice_tracker` database and its data.
PG_OCR_DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/ocr_db
# auth-service's own restricted role (see migration 1730000000014_auth_restricted_role)
# — granted SELECT/INSERT/UPDATE on users/companies/invites only, nothing else.
AUTH_PG_DATABASE_URL=postgres://auth_service:postgrespassword@postgres:5432/invoice_tracker
# genai-service's own database (genai_db) — invoice_embeddings + the pgvector
# match function, never through Hasura. See services/genai-service/app/db.py.
GENAI_PG_DATABASE_URL=postgres://genai_service:postgrespassword@postgres:5432/genai_db
# ml-service's own database (ml_db) — ml_drift_reports/ml_retrain_events/
# duplicate_flags/delay_predictions, never through Hasura. See
# services/ml-service/app/db.py.
ML_PG_DATABASE_URL=postgres://ml_service:postgrespassword@postgres:5432/ml_db

# --- Hasura ---
HASURA_GRAPHQL_ADMIN_SECRET=devsecret
# What the Python services use to reach Hasura (compose overrides host->service name).
HASURA_ENDPOINT=http://localhost:8088/v1/graphql
# Only Hasura itself and the web BFF (apps/web) use this now — every Python
# service instead mints its own scoped-role JWT with the key below (see
# hasura/metadata's ml_service/genai_writer/notifier/ocr_service/finance_user
# roles and each service's app/hasura.py).
HASURA_ADMIN_SECRET=devsecret
# HS256 shared key — services that call Hasura as a specific role mint JWTs with this.
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"dev-jwt-signing-key-change-me-32chars-min"}

# --- Service URLs (referenced by Hasura metadata: action, event trigger, cron;
# also read directly by the web app's server/ BFF code) ---
ML_SERVICE_URL=http://ml-service:8002
ML_SERVICE_SCORE_URL=http://ml-service:8002/score
NOTIFICATION_SERVICE_URL=http://notification-service:8004
GENAI_SERVICE_URL=http://genai-service:8003
OCR_SERVICE_URL=http://ocr-service:8006
# Server-side only (the web app's api/{login,register,refresh,users,invites}
# routes call this — never sent to the browser despite the NEXT_PUBLIC_ name).
NEXT_PUBLIC_AUTH_URL=http://auth-service:8005

# --- Internal service-to-service auth ---
# Shared secret the web BFF and Hasura (event/cron triggers, actions) send as
# X-Internal-Token when calling ingestion/ml/genai/notification/ocr — those
# services reject calls without it (shared_types.auth.require_internal_token).
# Leave unset in local dev only if you're fine with those endpoints being
# unreachable; generate a real value (e.g. `openssl rand -hex 32`) for prod.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# --- LLM for genai-service + ocr-service (optional; keyword/regex fallback when unset) ---
# Any OpenAI-compatible endpoint. Groq has a free tier: https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
#   local (Ollama):   LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.1
#   OpenAI:           LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini
#
# Alternative: Azure OpenAI (used only if the LLM_* vars above are unset).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- genai-service RAG (CPU, no GPU / no external vector DB) ---
# CPU sentence-transformers model for invoice embeddings (must be 384-dim to match
# the vector(384) column in migration 1730000000002).
EMBEDDING_MODEL=all-MiniLM-L6-v2
# genai-service reads Hasura as genai_readonly; /embed writes as genai_writer
# (both self-minted JWTs — see hasura/metadata's role permissions).

# --- ocr-service (CPU PaddleOCR; no GPU, no paid OCR API) ---
# Field extraction reuses the AZURE_OPENAI_* creds above; regex fallback when unset.
# OCR_RENDER_DPI=300  OCR_UPSCALE=1.5  OCR_MAX_DESKEW_DEG=15   (preprocessing knobs)
# OCR_CONF_FINANCIAL=0.92  OCR_CONF_OTHER=0.80                  (review-queue thresholds)
# Invalid drafts are written to review_queue as the ocr_service role (self-minted JWT).

# --- notification-service ---
# Each company's overdue digest goes to the recipients its admin sets in Settings.
# SMTP_HOST=              SMTP_PORT=587   SMTP_STARTTLS=1
# SMTP_USER=              SMTP_PASSWORD=
# EMAIL_FROM=ap-bot@acme.test

# --- auth-service ---
AUTH_TOKEN_TTL_SECONDS=3600
# Browser-facing URL of the web app — used to build the invite-accept link
# emailed to teammates (app/email.py). Must match the host-mapped port
# (docker-compose maps web to 3002, not the container's internal 3000).
WEB_URL=http://localhost:3002
# Browser origins allowed to call auth-service directly (rare — the web BFF
# proxies most calls server-side). Unset = deny all cross-origin requests.
# AUTH_CORS_ORIGINS=https://your-domain.example
# auth-service's Keycloak Admin API client (infra/keycloak/realm-export.json's
# "auth-service-admin" client) — used to provision the credential-owning
# account behind every user auth-service creates (register/invite/create_user).
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=invoice-tracker
KEYCLOAK_ADMIN_CLIENT_ID=auth-service-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-keycloak-auth-service-secret-change-me

# --- Keycloak (real OIDC IdP — see infra/keycloak/realm-export.json) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin-password-change-me

# --- web BFF (apps/web) ---
# REQUIRE_AUTH=1  # reject unauthenticated calls to /api/graphql (leave unset for the demo)
# NextAuth/Auth.js — see apps/web/auth.ts. AUTH_SECRET encrypts its own
# session cookie; generate a real one with `openssl rand -base64 32` for prod.
AUTH_SECRET=dev-nextauth-secret-change-me-32chars-min
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=web-bff
AUTH_KEYCLOAK_SECRET=dev-keycloak-web-bff-secret-change-me

# First platform super admin, created by auth-service on startup if none exists.
# Leave blank to skip. Change the password after first login.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Platform mail (demo requests / leads) goes ONLY here — the super admin. Comma-separated.
PLATFORM_EMAIL_TO=
